    "access": "public"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean:build": "rimraf ./dist",
    "dev": "nodemon",
    "lint": "eslint .",
    "lint:fix": "pnpm lint --fix",
    "format": "prettier --check .",
