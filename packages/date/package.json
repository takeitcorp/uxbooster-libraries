{
  "name": "@uxbooster/date",
  "version": "2.0.0",
  "description": "Date utility library for UXBooster.",
  "author": "Take Corp.",
  "license": "MIT",
  "keywords": [
    "uxbooster",
    "date"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/takeitcorp/uxbooster-libraries.git",
    "directory": "packages/date"
  },
  "bugs": {
